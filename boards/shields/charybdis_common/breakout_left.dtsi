/*
 * LEFT-half breakout pad map (Charybdis Full, 4x6).
 *
 * Raw nRF pins: each macro carries controller phandle AND pin, so "24"
 * always means P0.24 — no Pro-Micro D-number translation. The macro NAME is
 * the PCB silkscreen pad label; the VALUE is the nice!nano nRF pin.
 *
 *   Pad        nRF pin    role              Pro-Micro pad (reference only)
 *   --------   --------   ---------------   -----------------------------
 *   L_PAD_R1   P0.31      row 0 (TAB)       21
 *   L_PAD_R2   P1.15      row 1 (ESC)       18
 *   L_PAD_R3   P0.24      row 2 (LGUI/Z)     5
 *   L_PAD_R4   P0.22      row 3 (thumbs)     4
 *   L_PAD_R5   P1.06      row 4 (number)     9
 *   L_PAD_C1   P0.02      col 0             19
 *   L_PAD_C2   P0.29      col 1             20
 *   L_PAD_C3   P0.09      col 2             10
 *   L_PAD_C4   P1.00      col 3              6
 *   L_PAD_C5   P0.11      col 4              7
 *   L_PAD_C6   P1.04      col 5              8
 *
 * The left half has no trackball.
 */

/* ---- Matrix pad -> nRF gpio (LEFT half) ---------------------------- */
#define L_PAD_R1   &gpio0 31
#define L_PAD_R2   &gpio1 15
#define L_PAD_R3   &gpio0 24
#define L_PAD_R4   &gpio0 22
#define L_PAD_R5   &gpio1 6

#define L_PAD_C1   &gpio0 2
#define L_PAD_C2   &gpio0 29
#define L_PAD_C3   &gpio0 9
#define L_PAD_C4   &gpio1 0
#define L_PAD_C5   &gpio0 11
#define L_PAD_C6   &gpio1 4

/* ---- Matrix row -> pad (consumed by charybdis.dtsi) ---------------- *
 * charybdis.dtsi references MATRIX_ROW{0..4}_GPIO. 5-row board (adds the
 * number row = row 4), so all five are mapped here. */
#define MATRIX_ROW0_GPIO   L_PAD_R1
#define MATRIX_ROW1_GPIO   L_PAD_R2
#define MATRIX_ROW2_GPIO   L_PAD_R3
#define MATRIX_ROW3_GPIO   L_PAD_R4
#define MATRIX_ROW4_GPIO   L_PAD_R5
