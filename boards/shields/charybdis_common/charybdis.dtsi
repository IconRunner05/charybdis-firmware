#include <dt-bindings/zmk/matrix_transform.h>
#include "../../config/charybdis-layouts.dtsi"

/*
 * Charybdis Full (4x6, 56-key) common shield definitions.
 *
 * Diode direction — single source of truth. Define CHARYBDIS_DIODE_COL2ROW
 * for col2row (this board's wiring); comment it out for row2col.
 *   col2row -> rows are inputs -> pull-down on row-gpios
 *   row2col -> cols are inputs -> pull-down on col-gpios (set in overlay)
 *
 * Row pins come from the per-side breakout map (breakout_left.dtsi /
 * breakout_right.dtsi) via MATRIX_ROW*_GPIO. Each per-side overlay MUST
 * include its breakout file BEFORE this one so the macros are defined.
 */
#define CHARYBDIS_DIODE_COL2ROW

#ifdef CHARYBDIS_DIODE_COL2ROW
  #define CHARYBDIS_DIODE_DIR  "col2row"
  #define CHARYBDIS_ROW_FLAGS  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)
#else
  #define CHARYBDIS_DIODE_DIR  "row2col"
  #define CHARYBDIS_ROW_FLAGS  (GPIO_ACTIVE_HIGH)
#endif

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &charybdis_physical_layout;
    };

    /* battery monitor */
    vbatt: vbatt {
	compatible = "zmk,battery-nrf-vddh";
    };

    /*
     * Charybdis (Full, 4x6) matrix transform.
     *
     * Electrical row map (see breakout_{left,right}.dtsi for pins):
     *   row 0 -> TAB main row
     *   row 1 -> ESC/home row
     *   row 2 -> LGUI/Z row
     *   row 3 -> thumb cluster
     *   row 4 -> NEW number row (sits physically above row 0)
     *
     * `map` is in keymap-text order (top-to-bottom, left-to-right), so the
     * number row (RC(4,*)) appears first even though it is electrical row 4.
     *
     * Thumb cluster: Left 5 (T1 T2 T3 / T4 T5), Right 3 (T6 T7 / T8).
     *   T1=(3,1) T2=(3,2) T3=(3,3) T4=(3,4) T5=(3,5)
     *   T6=(3,11) T7=(3,10) T8=(3,9)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
	RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,11) RC(4,10) RC(4,9) RC(4,8) RC(4,7) RC(4,6)
	RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
	RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
	RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
	                RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,11) RC(3,10) RC(3,9)
        >;
    };

    five_column_transform: keymap_transform_1 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <5>;

        map = <
	RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,10) RC(4,9) RC(4,8) RC(4,7) RC(4,6)
	RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
	RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
	RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
	                RC(3,3) RC(3,4) RC(3,5)  RC(3,10) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;

        diode-direction = CHARYBDIS_DIODE_DIR;

        /* Row pins from the per-side breakout map. Edit the breakout file
           for your half, not this list. Col pins are set per-side. */
        row-gpios
            = <MATRIX_ROW0_GPIO CHARYBDIS_ROW_FLAGS>
            , <MATRIX_ROW1_GPIO CHARYBDIS_ROW_FLAGS>
            , <MATRIX_ROW2_GPIO CHARYBDIS_ROW_FLAGS>
            , <MATRIX_ROW3_GPIO CHARYBDIS_ROW_FLAGS>
            , <MATRIX_ROW4_GPIO CHARYBDIS_ROW_FLAGS>
            ;
    };
};
