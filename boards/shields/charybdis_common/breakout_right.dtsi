/*
 * RIGHT-half breakout pad map (Charybdis Full, 4x6).
 *
 * Raw nRF pins: each macro carries controller phandle AND pin, so "24"
 * always means P0.24 — no Pro-Micro D-number translation. The macro NAME is
 * the PCB silkscreen pad label; the VALUE is the nice!nano nRF pin.
 *
 *   Pad        nRF pin    role              Pro-Micro pad (reference only)
 *   --------   --------   ---------------   -----------------------------
 *   R_PAD_R1   P0.31      row 0 (TAB)       21
 *   R_PAD_R2   P1.15      row 1 (ESC)       18
 *   R_PAD_R3   P0.24      row 2 (LGUI/Z)     5
 *   R_PAD_R4   P0.22      row 3 (thumbs)     4
 *   R_PAD_R5   P1.06      row 4 (number)     9
 *   R_PAD_C1   P0.02      col 0             19
 *   R_PAD_C2   P0.29      col 1             20
 *   R_PAD_C3   P0.09      col 2             10
 *   R_PAD_C4   P1.00      col 3              6
 *   R_PAD_C5   P0.11      col 4              7
 *   R_PAD_C6   P1.04      col 5              8
 *
 * Trackball (PMW3610) pins are defined directly in
 * charybdis_trackball/charybdis_pmw3610.dtsi (SCK P0.08, MOSI/MISO P0.17,
 * CS P0.20, IRQ P0.06) — distinct from every matrix pin above.
 */

/* ---- Matrix pad -> nRF gpio (RIGHT half) --------------------------- */
#define R_PAD_R1   &gpio0 31
#define R_PAD_R2   &gpio1 15
#define R_PAD_R3   &gpio0 24
#define R_PAD_R4   &gpio0 22
#define R_PAD_R5   &gpio1 6

#define R_PAD_C1   &gpio0 2
#define R_PAD_C2   &gpio0 29
#define R_PAD_C3   &gpio0 9
#define R_PAD_C4   &gpio1 0
#define R_PAD_C5   &gpio0 11
#define R_PAD_C6   &gpio1 4

/* ---- Matrix row -> pad (consumed by charybdis.dtsi) ---------------- */
#define MATRIX_ROW0_GPIO   R_PAD_R1
#define MATRIX_ROW1_GPIO   R_PAD_R2
#define MATRIX_ROW2_GPIO   R_PAD_R3
#define MATRIX_ROW3_GPIO   R_PAD_R4
#define MATRIX_ROW4_GPIO   R_PAD_R5
