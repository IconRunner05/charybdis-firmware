#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&trackball_listener {
    /* base processor chain on all layers — 0.5x scaler matches reference
     * master's pointer speed so the trackball feels identical to the
     * previously-flashed firmware. (The reference also puts a
     * zip_ble_report_rate_limit noise-gate first, but that input processor
     * doesn't exist in this repo's ZMK revision; the scaler is the part that
     * governs perceptible speed.) */
    input-processors = <&zip_xy_scaler 1 2>;

    /* scroll override — layer 5 (reference SCROLL) and layer 7 (this repo's
     * other keymaps' SCROLL) both scroll. */
    scroller: scroller {
        layers           = <5 7>;
        input-processors = <
            &zip_xy_scaler 1 20                              // Scales the scroll speed
            &zip_xy_to_scroll_mapper                         // Converts XY movement to scroll events
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT) // Inverts the scroll direction
        >;
    };

    /* layer-7 slow-pointer override */
    slow_pointer: slow_pointer {
        layers           = <6>;
        input-processors = <&zip_xy_scaler 2 6>;
    };
};
